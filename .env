# Keep every image as a real emitted file.
#
# CRA inlines assets smaller than this limit as `data:` URIs. The gallery reads
# each photo's date and dimensions out of the *emitted filename*
# (src/App.constant.ts), so an inlined image has no filename to parse — the parse
# throws and the photo silently disappears from the wall. Setting the limit to 0
# forces every image to be emitted as a file with its original name.
IMAGE_INLINE_SIZE_LIMIT=0
